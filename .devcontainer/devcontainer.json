// GitHub Codespaces / VS Code Dev Containers setup for KAIRO.
// Works when Docker cannot run on your own computer: the codespace is a Linux
// machine in the cloud with its own Docker daemon (docker-in-docker), so the
// runner can start the sandbox containers there. See docs/codespaces.md.
{
  "name": "KAIRO",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": true }
  },
  // Building every sandbox image needs about 8 GB of disk; 4 cores keep the
  // Kotlin and C# compilers inside their time limits.
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [5173, 8000, 8080],
  "portsAttributes": {
    "5173": { "label": "KAIRO (make web)", "onAutoForward": "openBrowser" },
    "8000": { "label": "API (make api)", "onAutoForward": "silent" },
    "8080": { "label": "KAIRO (docker compose)", "onAutoForward": "notify" },
    "8081": { "label": "Runner: internal, do not make public", "onAutoForward": "ignore" },
    "8099": { "label": "Mock AI for tests", "onAutoForward": "ignore" }
  },
  // Python and web dependencies. Sandbox images are built on demand
  // (`make image-gcc`, or `make images` for all of them: 15-30 minutes).
  "postCreateCommand": "make setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright"
      ]
    }
  }
}
