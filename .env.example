# Copy to .env (never commit .env).

# Shared secret between the API and the runner. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNNER_TOKEN=change-me

# How many sandboxes may run at once (the API dispatches the same number).
RUNNER_WORKERS=4

# Port for the web app + API when using docker compose.
WEB_PORT=8080

# Which network interface the app listens on. 127.0.0.1 = this computer only.
# Use 0.0.0.0 only on a trusted network: anyone who can reach the port can run code.
WEB_BIND=127.0.0.1

# ---- Saarthi, the AI assistant (optional) ----
# Without a key, KAIRO works normally and Saarthi says it is not set up.
# Keys stay on the server: they are never sent to the browser or written to logs.
#
# Claude (default). Create a key at https://platform.claude.com and paste it here.
CC_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model: empty = claude-haiku-4-5-20251001 (fast, low cost). For deeper answers: claude-sonnet-5
CC_AI_MODEL=
#
# Or any OpenAI-compatible server, e.g. a free local model with Ollama:
#   CC_AI_PROVIDER=openai
#   CC_AI_BASE_URL=http://host.docker.internal:11434/v1
#   CC_AI_MODEL=llama3.1
#   CC_AI_API_KEY=            (not needed for Ollama; for OpenAI use OPENAI_API_KEY)
# Free hosted models (OpenAI-compatible; limits and models change, see docs/saarthi.md):
#   Google Gemini:  CC_AI_PROVIDER=openai  CC_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                   CC_AI_MODEL=<a current Gemini Flash model id>  CC_AI_API_KEY=<key from Google AI Studio>
#   Groq:           CC_AI_PROVIDER=openai  CC_AI_BASE_URL=https://api.groq.com/openai/v1  CC_AI_API_KEY=<key>
CC_AI_BASE_URL=
CC_AI_API_KEY=
#
# Budget guards (requests only happen when a student presses a Saarthi button):
# CC_AI_REQUESTS_PER_MINUTE=6   CC_AI_REQUESTS_PER_DAY=150   CC_AI_DAILY_BUDGET=3000
# AI autocomplete (ghost text, an extension students switch on) has its own limits:
# CC_AI_COMPLETE_PER_MINUTE=30   CC_AI_COMPLETE_PER_DAY=1500   CC_AI_COMPLETE_DAILY_BUDGET=20000

# ---- Accounts (optional): sign-in with Google, GitHub or email via Supabase ----
# Without these, students start as guests (saved in their browser). Both values
# are public by design (they end up in the web app): the project URL and its
# publishable key from Supabase -> Project Settings -> API. Never put a
# service-role key here. See docs/accounts.md. Rebuild the api image after
# changing them (docker compose build api).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Local development without compose (see README) ----
# API:    CC_RUNNER_URL=http://127.0.0.1:8081  CC_RUNNER_TOKEN=<same as RUNNER_TOKEN>
# Runner: RUNNER_TOKEN=<same>  RUNNER_WORKERS=4
